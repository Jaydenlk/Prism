# =============================================================================
# Prism v2 — Environment Variables Template (DOC-01 v4 §11.4)
# Copy to .env and fill in real values before starting services.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---------------------------------------------------------
PRISM_ENV=development
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_in_production

# --- Database ------------------------------------------------------------
DATABASE_URL=postgresql://prism:prism_dev_pass@postgres:5432/prism_dev

# --- Redis ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Three Independent Secrets (ADR-004 / ADR-050) -----------------------
# CRITICAL: All three MUST be different strings, each >= 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS_JWT_SECRET_AAAAAAAAAAAAAAAAAAAAAAAAAAAA
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS_ENCRYPTION_KEY_BBBBBBBBBBBBBBBBBBBBBBBB
CALLBACK_SECRET=REPLACE_WITH_64_HEX_CHARS_CALLBACK_SECRET_CCCCCCCCCCCCCCCCCCCCCC

# --- JWT Expiry ----------------------------------------------------------
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Run / Harness Limits ------------------------------------------------
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_SECONDS=600
MAX_TURNS_PER_RUN=50
LOOP_DETECTION_WINDOW=5

# --- Circuit Breaker (Harness / Provider failover) -----------------------
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=300

# --- Heartbeat / SSE Ticket ----------------------------------------------
HEARTBEAT_INTERVAL_SECONDS=15
SSE_TICKET_TTL_SECONDS=60

# --- OTel Tracing (optional, leave blank to disable) --------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=prism-backend

# --- Prometheus ----------------------------------------------------------
PROMETHEUS_METRICS_ENABLED=true
