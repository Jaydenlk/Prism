# =============================================================================
# Prism v2 — Environment Variables Template (DOC-01 v4 §11.4)
# Copy to .env and fill in real values before starting services.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---------------------------------------------------------
PRISM_ENV=development
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_in_production

# --- Database ------------------------------------------------------------
DATABASE_URL=postgresql://prism:prism_dev_pass@postgres:5432/prism_dev

# --- Redis ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Three Independent Secrets (ADR-004 / ADR-050) -----------------------
# CRITICAL: All three MUST be different strings, each >= 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS_JWT_SECRET_AAAAAAAAAAAAAAAAAAAAAAAAAAAA
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS_ENCRYPTION_KEY_BBBBBBBBBBBBBBBBBBBBBBBB
CALLBACK_SECRET=REPLACE_WITH_64_HEX_CHARS_CALLBACK_SECRET_CCCCCCCCCCCCCCCCCCCCCC

# --- JWT Expiry ----------------------------------------------------------
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Run / Harness Limits ------------------------------------------------
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_SECONDS=600
MAX_TURNS_PER_RUN=50
LOOP_DETECTION_WINDOW=5

# --- Circuit Breaker (Harness / Provider failover) -----------------------
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=300

# --- Heartbeat / SSE Ticket ----------------------------------------------
HEARTBEAT_INTERVAL_SECONDS=15
SSE_TICKET_TTL_SECONDS=60

# --- OTel Tracing (optional, leave blank to disable) --------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=prism-backend

# --- Prometheus ----------------------------------------------------------
PROMETHEUS_METRICS_ENABLED=true

# --- LLM Provider API Keys (seeds for scope=system providers on bootstrap)
# Admin can update these via /api/v1/providers after login; users can add
# their own via scope=user providers without touching these.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Search MCP API Keys (system-scope builtin MCP servers; missing keys skip auto-registration)
# searxng: self-hosted via docker compose (no API key, free + unlimited)
# Random secret used to sign SearXNG sessions; auto-generated by start.sh on first run.
SEARXNG_SECRET_KEY=
# exa: https://dashboard.exa.ai/api-keys (HTTP Streamable transport, https://mcp.exa.ai/mcp)
EXA_API_KEY=
# Tavily AI: https://app.tavily.com/sign-in (stdio transport, 1000 free queries/month)
TAVILY_API_KEY=

# --- Google OAuth (Task B) -----------------------------------------------
# Register at https://console.developers.google.com → Credentials → OAuth 2.0
# Leave blank to disable Google login (frontend hides button automatically).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_BASE_URL=http://localhost:8080

# --- Feishu Bot (conversational bot, requires app from open.feishu.cn) ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_MODE=websocket
# FEISHU_ENCRYPT_KEY=     # only needed for webhook mode
# FEISHU_VERIFICATION_TOKEN=  # only needed for webhook mode

# --- WeCom / 企业微信 Bot (requires app from work.weixin.qq.com) ----------
WECOM_CORP_ID=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_AGENT_ID=
WECOM_SECRET=

# --- Telegram Bot (requires bot from @BotFather) --------------------------
TELEGRAM_BOT_TOKEN=
